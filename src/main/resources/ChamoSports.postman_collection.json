{
  "info": {
    "name": "ChamoSports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Result",
      "item": [
        {
          "name": "Get Result List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/result",
              "host": ["{{baseUrl}}"],
              "path": ["result"]
            }
          }
        }
      ]
    },
    {
      "name": "Training",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": 1,\n  \"usersStats\": [\n    {\n      \"userId\": 1,\n      \"powerShoot\": 10,\n      \"speedShoot\": 10,\n      \"effectiveShoot\": 10,\n      \"totalShoot\": 30\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/training/register",
              "host": ["{{baseUrl}}"],
              "path": ["training", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Team",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TeamA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/team/register",
              "host": ["{{baseUrl}}"],
              "path": ["team", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rolId\": 1,\n  \"teamId\": 1,\n  \"name\": \"chamo\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": ["{{baseUrl}}"],
              "path": ["user", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"chamo\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["user", "login"]
            }
          }
        }
      ]
    }
  ]
}
